---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { PROJECTS } from "@consts";

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const collection = (await getCollection("awards"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const awards = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Projects
      </div>
      <ul class="animate flex flex-col gap-4">
        {
          projects.map((project) => (
            <li>
              <ArrowCard entry={project}/>
            </li>
          ))
        }
      </ul>

      <section class="space-y-6">
        <div class="animate font-semibold text-black dark:text-white">
          Awards & Recognition
        </div>
        <ul class="flex flex-col space-y-4">
          {
            awards.map(entry => (
              <li class="animate">
                <div class="font-semibold text-black dark:text-white">
                  {entry.data.organization} ({entry.data.date.getFullYear()})
                </div>
                {entry.data.project && (
                  <div class="text-sm opacity-75">
                    {entry.data.project}
                  </div>
                )}
                <div class="text-sm opacity-75 mt-2 space-y-1">
                  {entry.data.awards && entry.data.awards.length > 0 && (
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="font-semibold">Awards:</span>
                      {entry.data.awards.map((award) => (
                        <span class="inline-block px-2 py-0.5 text-xs rounded-md border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] text-black dark:text-white">
                          {award}
                        </span>
                      ))}
                    </div>
                  )}
                  {entry.data.categories && entry.data.categories.length > 0 && (
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="font-semibold">Categories:</span>
                      {entry.data.categories.map((category) => (
                        <span class="inline-block px-2 py-0.5 text-xs rounded-md border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] text-black dark:text-white">
                          {category}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <article class="mt-3">
                  <entry.Content />
                </article>
                {entry.data.links && entry.data.links.length > 0 && (
                  <div class="text-sm mt-3">
                    <svg 
                      xmlns="http://www.w3.org/2000/svg" 
                      viewBox="0 0 24 24"
                      class="inline-block w-4 h-4 mr-1.5 stroke-2 fill-none stroke-current opacity-75">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                    {entry.data.links.map((link, index) => (
                      <>
                        <Link href={link.url} external>
                          {link.label}
                        </Link>
                        {index < entry.data.links!.length - 1 && <span class="opacity-75"> • </span>}
                      </>
                    ))}
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>