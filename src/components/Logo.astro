---

<div class="flex items-center justify-center">
  <div class="relative group">
    <!-- Main logo container with smaller, more proportional dimensions -->
    <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 dark:from-gray-100 dark:via-white dark:to-gray-50 shadow-md shadow-black/8 dark:shadow-white/4 transition-all duration-500 ease-out group-hover:shadow-lg group-hover:shadow-black/12 dark:group-hover:shadow-white/8 group-hover:scale-[1.03]">
      <!-- Inner glow effect -->
      <div class="absolute inset-0.5 rounded-md bg-gradient-to-br from-white/5 to-transparent dark:from-black/5 opacity-60"></div>
      
      <!-- Typography with perfect optical alignment -->
      <div class="relative flex items-center justify-center">
        <span class="text-white dark:text-gray-900 font-semibold text-sm tracking-[-0.01em] leading-none select-none" style="font-feature-settings: 'kern' 1, 'liga' 1;">
          HK
        </span>
      </div>
      
      <!-- Subtle highlight for depth -->
      <div class="absolute top-0.5 left-0.5 right-0.5 h-1.5 bg-gradient-to-b from-white/10 to-transparent dark:from-black/5 rounded-t-md"></div>
    </div>
    
    <!-- Hover state enhancement -->
    <div class="absolute inset-0 rounded-lg bg-gradient-to-br from-blue-500/0 via-purple-500/0 to-blue-600/0 group-hover:from-blue-500/5 group-hover:via-purple-500/3 group-hover:to-blue-600/5 transition-all duration-700 ease-out"></div>
    
    <!-- Focus ring for accessibility -->
    <div class="absolute inset-0 rounded-lg ring-0 ring-blue-500/20 group-focus-visible:ring-2 transition-all duration-200"></div>
  </div>
</div>