---
import { PROJECTS_PASSWORD } from "@consts";
import BackToPrev from "@components/BackToPrev.astro";
---

<div id="password-gate" class="hidden">
  <div class="animate">
    <BackToPrev href="/projects">
      Back to projects
    </BackToPrev>
  </div>
  <div class="space-y-6 my-10">
    <h4 class="animate font-semibold text-black dark:text-white">
      Password, please!
    </h4>
    <p class="animate">
      Please enter the password to view project details. Ask Harrison if you don't have it.
    </p>
    <form id="password-form" class="animate space-y-4">
      <div>
        <input
          type="password"
          id="password-input"
          placeholder="Enter password"
          autocomplete="off"
          class="w-full px-4 py-3 rounded-lg border border-black/15 dark:border-white/20 bg-transparent text-black dark:text-white placeholder:text-black/40 dark:placeholder:text-white/40 focus:outline-none focus:border-black/30 dark:focus:border-white/40 transition-colors duration-300"
        />
      </div>
      <div id="password-error" class="hidden text-red-600 dark:text-red-400 text-sm">
        Incorrect password. Please try again.
      </div>
      <button
        type="submit"
        class="px-6 py-3 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
      >
        Submit
      </button>
    </form>
  </div>
</div>

<div id="protected-content" class="hidden">
  <slot />
</div>

<script is:inline define:vars={{ password: PROJECTS_PASSWORD }}>
  (function() {
    const SESSION_KEY = "projects_authenticated";
    const passwordGate = document.getElementById("password-gate");
    const protectedContent = document.getElementById("protected-content");
    const passwordForm = document.getElementById("password-form");
    const passwordInput = document.getElementById("password-input");
    const passwordError = document.getElementById("password-error");

    function isAuthenticated() {
      return sessionStorage.getItem(SESSION_KEY) === "true";
    }

    function setAuthenticated() {
      sessionStorage.setItem(SESSION_KEY, "true");
    }

    function showContent() {
      passwordGate.classList.add("hidden");
      protectedContent.classList.remove("hidden");
    }

    function showPasswordForm() {
      protectedContent.classList.add("hidden");
      passwordGate.classList.remove("hidden");

      setTimeout(() => {
        const animateElements = passwordGate.querySelectorAll(".animate");
        animateElements.forEach((element, index) => {
          setTimeout(() => {
            element.classList.add("show");
          }, index * 150);
        });
      }, 50);
    }

    function handleSubmit(e) {
      e.preventDefault();
      const enteredPassword = passwordInput.value;

      if (enteredPassword === password) {
        setAuthenticated();
        showContent();

        setTimeout(() => {
          const animateElements = protectedContent.querySelectorAll(".animate");
          animateElements.forEach((element, index) => {
            setTimeout(() => {
              element.classList.add("show");
            }, index * 150);
          });
        }, 50);
      } else {
        passwordError.classList.remove("hidden");
        passwordInput.value = "";
        passwordInput.focus();
      }
    }

    if (isAuthenticated()) {
      showContent();
    } else {
      showPasswordForm();
    }

    passwordForm.addEventListener("submit", handleSubmit);

    passwordInput.addEventListener("input", function() {
      passwordError.classList.add("hidden");
    });
  })();
</script>
